#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    default_kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        label = "default_kscan";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> 
            , <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    
    default_transform: matrix_transform {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <5>;
        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11)
        >;
    };


    physical_layout0: physical_layout_0 {
        compatible = "zmk,physical-layout";
        display-name = "Default Layout";
        transform = <&default_transform>;
        kscan = <&default_kscan>;

        keys  //                            w   h      x      y      rot     rx     ry
            // Row 1 - nums
              = <&key_physical_attrs 100 100      0     55        0      0      0>
              , <&key_physical_attrs 100 100    100     55        0      0      0>
              , <&key_physical_attrs 100 100    200     16        0      0      0>
              , <&key_physical_attrs 100 100    300      0        0      0      0>
              , <&key_physical_attrs 100 100    400     16        0      0      0>
              , <&key_physical_attrs 100 100    500     26        0      0      0>
              , <&key_physical_attrs 100 100   1075     26        0      0      0>
              , <&key_physical_attrs 100 100   1175     16        0      0      0>
              , <&key_physical_attrs 100 100   1275      0        0      0      0>
              , <&key_physical_attrs 100 100   1375     16        0      0      0>
              , <&key_physical_attrs 100 100   1475     55        0      0      0>
              , <&key_physical_attrs 100 100   1575     55        0      0      0>
            // Row 2 - num
              , <&key_physical_attrs 100 100      0    155        0      0      0>
              , <&key_physical_attrs 100 100    100    155        0      0      0>
              , <&key_physical_attrs 100 100    200    116        0      0      0>
              , <&key_physical_attrs 100 100    300    100        0      0      0>
              , <&key_physical_attrs 100 100    400    116        0      0      0>
              , <&key_physical_attrs 100 100    500    126        0      0      0>
              , <&key_physical_attrs 100 100   1075    126        0      0      0>
              , <&key_physical_attrs 100 100   1175    116        0      0      0>
              , <&key_physical_attrs 100 100   1275    100        0      0      0>
              , <&key_physical_attrs 100 100   1375    116        0      0      0>
              , <&key_physical_attrs 100 100   1475    155        0      0      0>
              , <&key_physical_attrs 100 100   1575    155        0      0      0>
            // Row 3 - top
              , <&key_physical_attrs 100 100      0    255        0      0      0>
              , <&key_physical_attrs 100 100    100    255        0      0      0>
              , <&key_physical_attrs 100 100    200    216        0      0      0>
              , <&key_physical_attrs 100 100    300    200        0      0      0>
              , <&key_physical_attrs 100 100    400    216        0      0      0>
              , <&key_physical_attrs 100 100    500    226        0      0      0>
              , <&key_physical_attrs 100 100   1075    226        0      0      0>
              , <&key_physical_attrs 100 100   1175    216        0      0      0>
              , <&key_physical_attrs 100 100   1275    200        0      0      0>
              , <&key_physical_attrs 100 100   1375    216        0      0      0>
              , <&key_physical_attrs 100 100   1475    255        0      0      0>
              , <&key_physical_attrs 100 100   1575    255        0      0      0>
            // Row 4 - home
              , <&key_physical_attrs 100 100      0    355        0      0      0>
              , <&key_physical_attrs 100 100    100    355        0      0      0>
              , <&key_physical_attrs 100 100    200    316        0      0      0>
              , <&key_physical_attrs 100 100    300    300        0      0      0>
              , <&key_physical_attrs 100 100    400    316        0      0      0>
              , <&key_physical_attrs 100 100    500    326        0      0      0>
              , <&key_physical_attrs 100 100   1075    326        0      0      0>
              , <&key_physical_attrs 100 100   1175    316        0      0      0>
              , <&key_physical_attrs 100 100   1275    300        0      0      0>
              , <&key_physical_attrs 100 100   1375    316        0      0      0>
              , <&key_physical_attrs 100 100   1475    355        0      0      0>
              , <&key_physical_attrs 100 100   1575    355        0      0      0>
            // Row 5 - bottom + thumbs
              , <&key_physical_attrs 100 100    100    455        0      0      0>
              , <&key_physical_attrs 100 100    200    416        0      0      0>
              , <&key_physical_attrs 100 100    300    400        0      0      0>
              , <&key_physical_attrs 100 100    399    496   (-400)    449    546>
              , <&key_physical_attrs 100 100    515    518     2100    565    568>
              , <&key_physical_attrs 100 100    608    583     3700    658    633>
              , <&key_physical_attrs 100 100    968    583  (-3700)   1018    633>
              , <&key_physical_attrs 100 100   1061    518  (-2100)   1111    568>
              , <&key_physical_attrs 100 100   1176    496      400   1226    546>
              , <&key_physical_attrs 100 100   1275    400        0      0      0>
              , <&key_physical_attrs 100 100   1375    416        0      0      0>
              , <&key_physical_attrs 100 100   1475    455        0      0      0>
            ;
    };

    chosen {
        zmk,kscan = &default_kscan;
        zmk,physical-layout = &physical_layout0;
    };
};